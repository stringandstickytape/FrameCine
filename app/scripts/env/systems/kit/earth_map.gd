## The map, made once.
static func texture() -> ImageTexture:
	if _texture != null:
		return _texture
	_texture = ImageTexture.create_from_image(ProcCache.image("earth_map.gd:texture", _draw_texture))
	return _texture


static func _draw_texture() -> Image:
	var land := PackedFloat32Array()
	land.resize(W * H)
	for poly: Array in LAND:
		_fill(land, poly, 1.0)
	for poly: Array in SEAS:
		_fill(land, poly, 0.0)
	var dry := PackedFloat32Array()
	dry.resize(W * H)
	for e: Array in DRY:
		_blob(dry, float(e[0]), float(e[1]), float(e[2]), float(e[3]), float(e[4]), false)
	var lights := PackedFloat32Array()
	lights.resize(W * H)
	for e: Array in CITIES:
		_blob(lights, float(e[0]), float(e[1]), float(e[2]), float(e[2]), float(e[3]), true)
	var data := PackedByteArray()
	data.resize(W * H * 4)
	for y in H:
		var lat := 90.0 - (y + 0.5) * 180.0 / H
		# The ice: Antarctica and the Arctic's sea ice by latitude, Greenland's cap (its land north of 60).
		var polar := smoothstep(-62.0, -70.0, lat) + smoothstep(78.0, 84.0, lat)
		for x in W:
			var i := y * W + x
			var lon := -180.0 + (x + 0.5) * 360.0 / W
			var l := land[i]
			var ice := polar
			if l > 0.5 and lat > 60.0 and lon > -60.0 and lon < -18.0 and lat < 84.0:
				ice = maxf(ice, smoothstep(60.0, 66.0, lat) * (1.0 - smoothstep(-24.0, -19.0, lon) * 0.5))
			if l > 0.5 and lat > 72.0:
				ice = maxf(ice, smoothstep(72.0, 78.0, lat))
			data[i * 4] = int(l * 255.0)
			data[i * 4 + 1] = int(clampf(dry[i], 0.0, 1.0) * 255.0)
			data[i * 4 + 2] = int(clampf(ice, 0.0, 1.0) * 255.0)
			data[i * 4 + 3] = int(clampf(lights[i] * l, 0.0, 1.0) * 255.0)
	var img := Image.create_from_data(W, H, false, Image.FORMAT_RGBA8, data)
	# Soften the coasts and the blobs a little (half and back): the shader cuts the coast across the soft edge.
	img.resize(W / 2, H / 2, Image.INTERPOLATE_BILINEAR)
	img.resize(W, H, Image.INTERPOLATE_CUBIC)
	img.generate_mipmaps()
	return img


## Fills a polygon ([lon, lat, ...]) into `out` with `value`, row by row (even-odd crossings); longitudes past 180
## wrap round.
static func _fill(out: PackedFloat32Array, poly: Array, value: float) -> void:
	var n := poly.size() / 2
	var xs := PackedFloat32Array()
	var ys := PackedFloat32Array()
	for k in n:
		xs.append((float(poly[k * 2]) + 180.0) * W / 360.0)
		ys.append((90.0 - float(poly[k * 2 + 1])) * H / 180.0)
	var y0 := maxi(int(floor(ys[0])), 0)
	var y1 := mini(int(ceil(ys[0])), H - 1)
	for k in n:
		y0 = mini(y0, maxi(int(floor(ys[k])), 0))
		y1 = maxi(y1, mini(int(ceil(ys[k])), H - 1))
	for y in range(y0, y1 + 1):
		var cy := y + 0.5
		var cross := PackedFloat32Array()
		for k in n:
			var j := (k + 1) % n
			var a := ys[k]
			var b := ys[j]
			if (a <= cy and b > cy) or (b <= cy and a > cy):
				cross.append(xs[k] + (cy - a) / (b - a) * (xs[j] - xs[k]))
		cross.sort()
		var c := 0
		while c + 1 < cross.size():
			var from := int(ceil(cross[c] - 0.5))
			var to := int(floor(cross[c + 1] - 0.5))
			for x in range(from, to + 1):
				out[y * W + posmod(x, W)] = value
			c += 2


## Adds a soft blob (an ellipse in degrees) into `out`, the largest of what is there and the blob; `peaked` lights:
## brightest in the middle, falling off.
static func _blob(out: PackedFloat32Array, lon: float, lat: float, rx: float, ry: float, k: float, peaked: bool) -> void:
	var cx := (lon + 180.0) * W / 360.0
	var cy := (90.0 - lat) * H / 180.0
	var px := rx * W / 360.0 + 1.0
	var py := ry * H / 180.0 + 1.0
	for y in range(maxi(int(cy - py), 0), mini(int(cy + py) + 1, H)):
		for x in range(int(cx - px), int(cx + px) + 1):
			var dx := (x + 0.5 - cx) / px
			var dy := (y + 0.5 - cy) / py
			var d := dx * dx + dy * dy
			if d >= 1.0:
				continue
			var v := k * (1.0 - d) if peaked else k * smoothstep(1.0, 0.45, sqrt(d))
			var i := y * W + posmod(x, W)
			out[i] = maxf(out[i], v)
