; FrameCine: the application. Runs on the headset with our engine fork (hardware video through
; modules/hwvideo) and on any desktop build of the engine (4.7) with a generated test-pattern source. See README.md.

config_version=5

[application]

config/name="FrameCine"
config/description="VR video player for a standalone headset."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
; --hands writes this file to switch hand tracking on at the next start (scripts/xr_spikes/xr_spikes.gd).
config/project_settings_override="user://xr_override.cfg"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

; Pointers raycast for themselves; the viewport's own picking only warns that it can't work in stereo.
common/enable_object_picking=false
; Object physics (docs/physics.md): Jolt, compiled into the device build. The ticks stay at 60 a second; the moving
; objects are interpolated to the frame by scripts/play/object_physics.gd itself (the engine's own interpolation
; stays off: it would delay every node the app moves in _process).
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver="vulkan"
rendering_device/driver.linuxbsd="vulkan"
rendering_device/driver.windows="vulkan"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=256
lights_and_shadows/positional_shadow/atlas_size=256

[shader_globals]

env_light={
"type": "float",
"value": 0.1
}
screen_center={
"type": "vec3",
"value": Vector3(0, 1.2, -3)
}
screen_glow={
"type": "float",
"value": 0.6
}
screen_thumb={
"type": "sampler2D",
"value": ""
}
screen_tint={
"type": "float",
"value": 0.0
}
screen_axis={
"type": "vec3",
"value": Vector3(0.333, 0, 0)
}

[xr]

openxr/enabled=true
openxr/extensions/render_model=true
openxr/extensions/eye_gaze_interaction=true
openxr/default_action_map="res://xr/openxr_action_map.tres"
; Without a runtime (or with --xr-mode off) the app falls back to a flat camera instead of showing an alert.
openxr/startup_alert=false
; No foveation (docs/decisions.md D22, revised 2026-11-23). With a foveated swapchain, late frames showed vertically
; flipped patches in one eye on the Frame, the scenery went blocky, and it clashed with films; level 0 on a foveated
; swapchain also cost more GPU time than no foveation at all.
openxr/foveation_level=0
openxr/foveation_dynamic=false
openxr/foveation_eye_tracked=false
openxr/foveation_with_subsampled_images=false
shaders/enabled=true
