{
	"schema": 4,
	"name": "TV 1993 - bedroom telly",
	"room": {"description": "A bedroom telly in 1993, seen from a bean bag on the floor.", "ambient": 0.04, "screen_glow": 1.0, "category": "tv"},
	"screen": {"center": [0.0, 0.95, -1.1], "size": [0.4, 0.3]},
	"acoustics": {"reflect": [0.25, 0.25, 0.25, 0.3, 0.12, 0.3], "rt60": 0.35, "wet": 0.34, "late": 1.4},
	"systems": [
		{"system": "light", "params": {"fill_top": [0.5, 0.46, 0.5], "fill_bottom": [0.16, 0.14, 0.16]}},
		{"system": "domestic", "id": "room", "params": {
			"style": "bedroom_1993", "half_width": 2.4, "front_z": -1.6, "back_z": 2.6, "height": 2.4,
			"screen": "telly", "screen_size": [0.4, 0.3], "screen_bottom": 0.8,
			"fort": "off", "fairy_lights": "on", "fairy_colour": [1.0, 0.8, 0.5],
			"fairy_glow": {"bind": "setting.fairy", "range": [0.0, 1.5], "smooth": 0.5},
			"window": "left", "window_width": 1.2, "outside": "none",
			"door": "back", "heater": "radiator",
			"seat_model": "cushion", "rows_front": 0, "rows_back": 0, "seats_per_row": 1,
			"walls": {"library": "painted_wall", "color": [0.3, 0.4, 0.55]},
			"telly_material": {"library": "dark_metal", "color": [0.1, 0.1, 0.11]}}},
		{"system": "seats", "params": {
			"model": "bean_bag",
			"places": [{"at": [1.75, 0.5, 1.1], "turn": 40.0, "model": "cushion"}],
			"upholstery": {"library": "corduroy", "color": [0.55, 0.12, 0.2]},
			"frame": {"library": "corduroy", "color": [0.55, 0.12, 0.2]}}},
		{"system": "sky", "params": {"facing": 0.0, "dusk": 1.0, "clouds": 0.75, "stars": 0.4, "milky_way": 0.0}},
		{"system": "weather", "params": {
			"mode": {"bind": "setting.weather", "map": {"rain": "heavy", "clear": "clear", "changing": "changing"}},
			"cycle_minutes": 20.0, "cycle_start": 0.3, "falls": "rain", "particles": 400,
			"areas": [{"min": [-7.0, 0.0, -2.8], "max": [-2.7, 4.0, 1.2]}],
			"pane": true, "pane_center": [-2.46, 1.5, -0.672], "pane_size": [1.2, 1.2], "pane_yaw": 90.0}},
		{"system": "presentation", "params": {"preset": "nightowl_1993", "starts_off": true}},
		{"system": "acoustics", "params": {"preset": "small_room"}},
		{"system": "sound_bed", "id": "radiator", "params": {"sound": "radiator", "place": "at",
			"at": [-2.35, 0.45, -0.67], "reach": 3.0}},
		{"system": "sound_bed", "id": "rain", "params": {"sound": "rain_glass", "place": "at",
			"at": [-2.46, 1.5, -0.67], "reach": 3.0, "level": {"bind": "weather.rain", "smooth": 2.0}}},
		{"system": "sound_bed", "id": "vcr", "params": {"sound": "vcr", "place": "at", "at": [0.0, 0.55, -1.1],
			"reach": 2.0}},
		{"system": "sound_bed", "id": "whine", "params": {"sound": "tube_whine", "place": "at", "at": [0.0, 0.95, -1.15],
			"reach": 2.0}}
	],
	"settings": [
		{"name": "weather", "type": "choice", "choices": ["rain", "clear", "changing"],
			"labels": ["Raining", "A dry night", "Showers"], "default": "changing", "label": "Weather at the window",
			"description": "Rain on the window, a clear night, or each in turn."},
		{"name": "fairy", "type": "range", "min": 0.0, "max": 1.0, "step": 0.1, "default": 0.7,
			"format": "percent", "label": "Fairy lights over the telly",
			"description": "How bright the fairy lights over the telly are. At the bottom: off."}
	],
	"cues": [
		{"name": "tape_in", "stop_in": ["preshow", "ended"], "when": {"state": "starting"},
			"requires": [{"setting": "ritual"}], "steps": [{"do": "presentation.switch_on"}, {"do": "vcr.play"}]},
		{"name": "switch_off", "when": {"state": ["ended", "preshow"]},
			"steps": [{"do": "presentation.switch_off"}]}
	],
	"timeline": {"starting_seconds": 8.0}
}
