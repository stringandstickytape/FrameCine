{
	"schema": 4,
	"name": "Drive-in - 1958",
	"room": {"description": "A drive-in lot at dusk, seen from a convertible's bench seat: the stars come out over the film, moths in the beam, mesas on the horizon.", "ambient": 0.03, "screen_glow": 0.8, "category": "cinema"},
	"screen": {"center": [0.0, 8.5, -49.4], "size": [24.0, 10.0]},
	"acoustics": {"reflect": [0.05, 0.05, 0.3, 0.0, 0.1, 0.05], "rt60": 0.2, "wet": 0.1},
	"systems": [
		{"system": "light", "params": {"fill_top": [0.22, 0.26, 0.4], "fill_bottom": [0.08, 0.07, 0.07],
			"spill": 2.0, "lamp_range": 20.0}},
		{"system": "terrace", "id": "lot", "params": {"style": "lot", "half_width": 34.0, "front_z": -50.0,
			"back_z": 40.0, "ground_y": -0.5, "ground_extent": 120.0, "parapet": false, "screen": "none",
			"screen_size": [24.0, 10.0], "screen_bottom": 4.0, "seating": false, "string_lights": false,
			"drive_in": true, "cars": 30, "name": "MESA MOON", "snack_sign": "SNACK BAR",
			"board": ["TWO FEATURES", "SHOW AT DUSK"],
			"ground": {"library": "terrazzo", "color": [0.36, 0.32, 0.28], "tiling": 2.5, "spill": 6.0},
			"frame": {"library": "rustic_planks", "color": [0.36, 0.3, 0.24]}}},
		{"system": "vehicle", "id": "car", "params": {"glint_at": [0.0, 3.05, 14.34], "glint_colour": [1.0, 0.3, 0.5],
			"reflect_screen": {"bind": "playback.playing", "range": [0.25, 1.0], "smooth": 2.0},
			"carpet": {"library": "woven_carpet", "color": [0.46, 0.2, 0.15]}}},
		{"system": "screen_frame", "params": {"masking": false, "lens": [0.0, 1.96, 15.2], "beam_style": "volume",
			"beam_strength": 0.0002}},
		{"system": "sky", "params": {"latitude": 35.0, "day_of_year": 200.0, "facing": 250.0, "glow_bearing": 295.0,
			"hour": 20.75, "afterglow": 1.0, "milky_detail": 1.0, "evening_star": 1.0,
			"twilight_zenith": "#1f3470", "twilight_horizon": "#dc8a58", "glow": "#ff7436", "belt_colour": "#a15e70",
			"night_zenith": "#04060f", "night_horizon": "#0e1324",
			"milky_way": {"bind": "playback.playing", "range": [0.35, 0.9], "smooth": 3.0}}},
		{"system": "vista", "params": {"items": [
			{"shape": "mesas", "azimuth": -60.0, "spread": 120.0, "distance": 160.0},
			{"shape": "mesas", "azimuth": 70.0, "spread": 110.0, "distance": 150.0, "seed": 7},
			{"shape": "mesas", "azimuth": 180.0, "spread": 100.0, "distance": 165.0, "count": 4, "seed": 19},
			{"shape": "hills", "colour": [0.13, 0.1, 0.09]},
			{"shape": "cacti", "azimuth": -78.0, "spread": 44.0, "distance": 84.0, "depth": 50.0, "count": 16,
				"floor_y": -0.5},
			{"shape": "cacti", "azimuth": 80.0, "spread": 44.0, "distance": 86.0, "depth": 50.0, "count": 16,
				"floor_y": -0.5, "seed": 5},
			{"shape": "cacti", "azimuth": -26.0, "spread": 18.0, "distance": 105.0, "depth": 40.0, "count": 6,
				"floor_y": -0.5, "seed": 9},
			{"shape": "cacti", "azimuth": 27.0, "spread": 18.0, "distance": 108.0, "depth": 40.0, "count": 6,
				"floor_y": -0.5, "seed": 13},
			{"shape": "cacti", "azimuth": 165.0, "spread": 90.0, "distance": 125.0, "depth": 40.0, "count": 12,
				"floor_y": -0.5, "seed": 17}]}},
		{"system": "life", "id": "moths", "params": {"creature": "moth", "count": 30}},
		{"system": "life", "id": "planes", "params": {"creature": "plane", "every": 300.0}},
		{"system": "presentation", "params": {
			"speaker": {"bind": "setting.tinny", "map": {"true": "window", "false": "none"}}}},
		{"system": "acoustics", "params": {"preset": "outdoors"}},
		{"system": "sound_bed", "id": "crickets", "params": {"sound": "crickets", "place": "around", "radius": 8.0,
			"reach": 8.0}},
		{"system": "sound_bed", "id": "train", "params": {"sound": "train", "place": "at", "at": [-260.0, 2.0, -280.0],
			"reach": 300.0, "every": 900.0}},
		{"system": "sound_bed", "id": "wind", "params": {"sound": "wind", "gain_db": -5.0, "film_db": -10.0}},
		{"system": "sound_bed", "id": "far_car", "params": {"sound": "far_car", "place": "at",
			"at": [-420.0, 1.0, 78.0], "to": [420.0, 1.0, 78.0], "reach": 80.0, "vary": 0.0}}
	],
	"settings": [
		{"name": "tinny", "type": "bool", "default": false, "label": "Window speaker",
			"description": "The film's sound from the little speaker hung on the car's window: tinny, mono, a little rattle."}
	],
	"cues": [
		{"name": "lamps_off", "when": {"state": ["starting", "playing"]},
			"steps": [{"set": "car.headlamps", "to": 0.0, "seconds": 0.5},
				{"set": "car.dial_glow", "to": 0.15, "seconds": 3.0},
				{"set": "lot.chase", "to": 0.0, "seconds": 4.0},
				{"set": "lot.ramp_lights", "to": 0.35, "seconds": 5.0},
				{"set": "lot.neon", "to": 0.65, "seconds": 6.0}]},
		{"name": "time_to_go", "when": {"state": "ended"},
			"steps": [{"set": "lot.chase", "to": 1.0, "seconds": 2.0}, {"set": "lot.neon", "to": 1.0, "seconds": 3.0},
				{"set": "lot.ramp_lights", "to": 1.0, "seconds": 3.0}, {"wait": 3.0},
				{"set": "car.dial_glow", "to": 0.5, "seconds": 1.0},
				{"set": "car.headlamps", "to": 1.2, "seconds": 0.5}]},
		{"name": "arrive", "when": {"state": "preshow"},
			"steps": [{"set": "car.headlamps", "to": 0.0, "seconds": 0.5},
				{"set": "car.dial_glow", "to": 0.5, "seconds": 1.0},
				{"set": "lot.chase", "to": 1.0, "seconds": 2.0}, {"set": "lot.neon", "to": 1.0, "seconds": 2.0},
				{"set": "lot.ramp_lights", "to": 1.0, "seconds": 2.0}]},
		{"name": "road", "when": {"every": 70.0}, "chance": 0.45, "steps": [{"do": "lot.car_passes", "args": {"way": 1}},
			{"do": "far_car.play"}]}
	],
	"timeline": {"starting_seconds": 8.0, "credits_minutes": 6.0, "tracks": [
		{"target": "sky.dusk", "by": "film.minutes", "keys": [[0.0, 0.0], [12.0, 0.75], [25.0, 1.0]], "smooth": 0.5},
		{"target": "sky.hour", "by": "film.minutes", "keys": [[0.0, 20.75], [180.0, 23.75]], "smooth": 1.0}]},
	"audio": {"level_db": 0.0, "pause_rise_db": 3.0}
}
