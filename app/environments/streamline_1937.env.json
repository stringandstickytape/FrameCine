{
	"schema": 4,
	"name": "Streamline 1937",
	"room": {"description": "A streamline cinema, 1937: coves that glow and change colour, a stepped proscenium round a rising sun, faience bands round the hall, an organ that rises from the pit, a festoon.", "ambient": 0.05, "screen_glow": 1.0, "curtains": false, "category": "cinema"},
	"screen": {"center": [0.0, 1.6, -13.8], "size": [12.0, 5.0]},
	"acoustics": {"reflect": [0.35, 0.35, 0.25, 0.4, 0.25, 0.35], "rt60": 0.9, "wet": 0.5},
	"systems": [
		{"system": "light", "params": {"spill": 0.35, "baked_fill": 0.2,
			"fill_top": [0.62, 0.5, 0.4], "fill_bottom": [0.2, 0.15, 0.12]}},
		{"system": "auditorium", "id": "hall", "params": {
			"wall_treatment": "plain", "proscenium": "none", "ceiling_cover": 0.0, "clouds": [],
			"sconce_joints": [], "handrails": false, "lens": [0.0, 5.75, 6.15],
			"seat_model": "plush", "seat_pitch": 0.6, "seats_per_row": 25,
			"seat_upholstery": {"library": "velvet", "color": [0.46, 0.17, 0.11], "tiling": 0.22},
			"seat_shell": {"library": "walnut_veneer", "color": [0.2, 0.12, 0.07]},
			"walls": {"library": "smooth_plaster", "color": [0.62, 0.5, 0.39]},
			"floor": {"library": "woven_carpet", "color": [0.13, 0.24, 0.2], "tiling": 0.9},
			"stage": {"library": "black_marble", "color": [0.1, 0.1, 0.09]}, "stage_top": -1.6,
			"house_lamp_colour": [1.0, 0.8, 0.56], "step_colour": [1.0, 0.62, 0.3]}},
		{"system": "kit", "id": "moderne", "params": {"builder": "hall", "bake_lamps": 8,
			"plaster": {"library": "smooth_plaster", "color": [0.86, 0.79, 0.64]},
			"wood": {"library": "walnut_veneer", "color": [0.3, 0.18, 0.1]},
			"gilt": {"library": "brass", "color": [0.86, 0.66, 0.32]},
			"faience": {"library": "white_marble", "color": [0.93, 0.87, 0.72]},
			"chrome": {"library": "brushed_steel", "color": [0.84, 0.84, 0.86]},
			"cove": {"bind": "playback.playing", "range": [1.0, 0.5], "smooth": 3.0},
			"cove_colour": {"bind": "setting.cove", "map": {
				"changing": [1.0, 0.72, 0.4], "gold": [1.0, 0.72, 0.4], "rose": [1.0, 0.5, 0.58],
				"jade": [0.42, 0.92, 0.7], "blue": [0.5, 0.64, 1.0]}},
			"cove_film_colour": {"bind": "film.colour", "strength": 0.85, "base": [1.0, 0.72, 0.4], "smooth": 1.5},
			"cove_film": {"bind": "playback.playing", "range": [0.0, 1.0], "smooth": 3.0},
			"pieces": [
				{"piece": "moderne_hall"},
				{"piece": "ziggurat"}]}},
		{"system": "kit", "id": "console", "params": {"builder": "hall", "group": "Console", "bake_lamps": 0,
			"faience": {"library": "white_marble", "color": [0.93, 0.89, 0.8]},
			"gilt": {"library": "brass", "color": [0.86, 0.66, 0.32]},
			"chrome": {"library": "brushed_steel", "color": [0.84, 0.84, 0.86]},
			"cove_colour": {"bind": "setting.cove", "map": {
				"changing": [1.0, 0.72, 0.4], "gold": [1.0, 0.72, 0.4], "rose": [1.0, 0.5, 0.58],
				"jade": [0.42, 0.92, 0.7], "blue": [0.5, 0.64, 1.0]}},
			"pieces": [
				{"piece": "organ_console", "at": [0.0, -4.3, -11.35]}]}},
		{"system": "motion", "id": "organ", "params": {"system": "console", "node": "Console",
			"path": [[0.0, 1.85, 0.0]], "speed": 0.25, "accel": 0.12}},
		{"system": "motion", "id": "festoon", "params": {"build": "festoon", "festoon_swags": 6, "speed": 0.5, "accel": 0.3,
			"festoon_top": 2.3, "festoon_size": [12.8, 8.05],
			"curtain": {"library": "velvet", "color": [0.72, 0.5, 0.2], "tiling": 0.3, "pleats": 2.4, "pleat_depth": 0.7}}},
		{"system": "screen_frame", "params": {"lens": [0.0, 5.75, 6.15]}},
		{"system": "atmosphere", "id": "air", "params": {"beam_haze": 0.15}},
		{"system": "acoustics", "params": {"preset": "cinema"}},
		{"system": "music", "id": "pipes", "params": {"instrument": "organ", "stop": "theatre", "plays_in": ["intermission"],
			"on": {"bind": "setting.ritual"}, "at": [0.0, -1.5, -11.35], "reach": 12.0}}
	],
	"settings": [
		{"name": "cove", "type": "choice", "choices": ["changing", "gold", "rose", "jade", "blue"],
			"labels": ["Changing", "Gold", "Rose", "Jade", "Blue"], "default": "changing",
			"label": "Cove colours",
			"description": "The cove lights' colour before the film. Changing: they move through the colours. In the film they take the film's colour."}
	],
	"cues": [
		{"name": "cove_cycle", "stop_in": ["starting", "playing"], "when": {"every": 20.0}, "states": ["preshow", "paused", "ended", "intermission"],
			"requires": [{"setting": "cove", "is": "changing"}],
			"steps": [
				{"set": "moderne.cove_colour", "to": [1.0, 0.5, 0.58], "seconds": 4.0},
				{"set": "console.cove_colour", "to": [1.0, 0.5, 0.58], "seconds": 4.0},
				{"wait": 5.0},
				{"set": "moderne.cove_colour", "to": [0.42, 0.92, 0.7], "seconds": 4.0},
				{"set": "console.cove_colour", "to": [0.42, 0.92, 0.7], "seconds": 4.0},
				{"wait": 5.0},
				{"set": "moderne.cove_colour", "to": [0.5, 0.64, 1.0], "seconds": 4.0},
				{"set": "console.cove_colour", "to": [0.5, 0.64, 1.0], "seconds": 4.0},
				{"wait": 5.0},
				{"release": "moderne.cove_colour", "seconds": 4.0},
				{"release": "console.cove_colour", "seconds": 4.0}
			]},
		{"name": "cove_settles", "when": {"state": ["starting", "playing"]},
			"steps": [{"release": "moderne.cove_colour", "seconds": 3.0}, {"release": "console.cove_colour", "seconds": 3.0}]},
		{"name": "prelude", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended", "intermission"]},
			"requires": [{"setting": "ritual"}],
			"steps": [
				{"wait": 3.0},
				{"do": "organ.rise", "args": {"seconds": 10.0}},
				{"do": "pipes.play", "args": {"seconds": 80.0}},
				{"wait": 82.0},
				{"do": "organ.lower", "args": {"seconds": 12.0}}
			]},
		{"name": "ritual", "stop_in": ["preshow", "ended"], "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [
				{"set": "light.house_lamps", "to": 0.5, "seconds": 2.0},
				{"do": "pipes.flourish"},
				{"do": "festoon.rise", "args": {"seconds": 8.0}},
				{"wait": 3.0},
				{"do": "organ.lower", "args": {"seconds": 12.0}},
				{"set": "light.house_lamps", "to": 0.15, "seconds": 5.0}
			]},
		{"name": "dim", "stop_in": ["preshow", "ended"], "when": {"state": "starting"}, "requires": [{"setting": "ritual", "is": false}],
			"steps": [{"set": "light.house_lamps", "to": 0.15, "seconds": 3.0}, {"do": "organ.lower", "args": {"seconds": 12.0}}]},
		{"name": "lights_up", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]},
			"steps": [
				{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0},
				{"do": "festoon.lower", "args": {"seconds": 8.0}}
			]}
	],
	"timeline": {"starting_seconds": 8.0, "credits_minutes": 6.0},
	"audio": {"level_db": 0.0, "pause_rise_db": 3.0}
}
