{
	"schema": 4,
	"name": "Nave",
	"room": {"ambient": 0.04, "screen_glow": 1.0, "category": "cinema"},
	"screen": {"center": [0.0, 3.4, -10.05], "size": [6.4, 3.6]},
	"acoustics": {"rt60": 1.6, "wet": 0.4},
	"systems": [
		{"system": "light", "params": {"spill": 4.5, "fill_top": [0.24, 0.21, 0.19], "fill_bottom": [0.08, 0.07, 0.06]}},
		{"system": "nave", "params": {"chancel_z": -6.5, "chancel_depth": 4.0, "rows_front": 4, "rows_back": 5,
			"rear_z": 7.5, "screen_size": [6.4, 3.6], "screen_bottom": 1.6, "rose_glow": 0.25,
			"stone": {"library": "rough_plaster", "color": [0.4, 0.37, 0.32], "tiling": 2.0},
			"columns": {"library": "white_marble", "color": [0.46, 0.43, 0.39]},
			"candles": {"bind": "setting.candles", "map": {"none": 0, "few": 2, "many": 4}}}},
		{"system": "seats"},
		{"system": "screen_frame", "params": {"beam": false, "margin": 0.3}}
	],
	"settings": [
		{"name": "candles", "type": "choice", "choices": ["none", "few", "many"], "labels": ["None", "A few", "Many"],
			"default": "few", "label": "Candles",
			"description": "Candle stands either side of the screen: none, two on each side, or four."}
	],
	"cues": [
		{"name": "rose_dims", "when": {"state": "starting"},
			"steps": [{"set": "nave.rose_glow", "to": 0.15, "seconds": 6.0}]},
		{"name": "rose_up", "when": {"state": ["preshow", "ended"]},
			"steps": [{"release": "nave.rose_glow", "seconds": 5.0}]}
	]
}
