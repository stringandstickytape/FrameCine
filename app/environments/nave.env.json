{
	"schema": 4,
	"name": "Nave",
	"room": {"description": "A Gothic nave at night, the screen in the chancel: piers rising into rib vaults, candles on iron stands and coronae, coloured glass and a rose window in the moonlight.", "ambient": 0.04, "screen_glow": 1.0, "category": "cinema"},
	"screen": {"center": [0.0, 3.4, -10.05], "size": [6.4, 3.6]},
	"acoustics": {"rt60": 1.6, "wet": 0.4},
	"systems": [
		{"system": "light", "params": {"spill": 0.6, "fill_top": [0.05, 0.047, 0.044], "fill_bottom": [0.03, 0.028, 0.026], "baked_fill": 0.5}},
		{"system": "nave", "params": {"style": "gothic", "vault": "rib", "chancel_z": -6.5, "chancel_depth": 4.0,
			"rows_front": 4, "rows_back": 5, "rear_z": 7.5, "bay": 3.5, "column_height": 5.0, "column_radius": 0.42,
			"wall_height": 12.0, "screen_size": [6.4, 3.6], "screen_bottom": 1.6, "rose_radius": 2.1, "rose_glow": 0.25,
			"window_glow": 0.3, "moonlight": 2.0,
			"stone": {"library": "rough_plaster", "color": [0.6, 0.56, 0.49], "tiling": 0.9},
			"columns": {"library": "black_marble", "color": [0.17, 0.15, 0.14]},
			"webs": {"library": "rough_plaster", "color": [0.66, 0.62, 0.55], "tiling": 2.0},
			"floor": {"library": "smooth_concrete", "color": [0.5, 0.47, 0.42], "tiling": 1.5},
			"pews": {"library": "oak_veneer", "color": [0.3, 0.2, 0.12]},
			"coronae": 3,
			"candles": {"bind": "setting.candles", "map": {"none": 0, "few": 2, "many": 4}},
			"coronae_lit": {"bind": "setting.candles", "map": {"none": false, "few": true, "many": true}},
			"votive": {"bind": "setting.candles", "map": {"none": false, "few": true, "many": true}}}},
		{"system": "screen_frame", "params": {"beam": false, "margin": 0.3}},
		{"system": "acoustics", "params": {"preset": "stone_nave", "rt60": 3.0}},
		{"system": "sound_bed", "id": "wind", "params": {"sound": "wind", "gain_db": -4.0, "film_db": -12.0,
			"place": "around", "at": [0.0, 13.0, 0.0], "radius": 4.0, "voices": 2, "reach": 10.0}},
		{"system": "sound_bed", "id": "candle", "params": {"sound": "candle", "gain_db": -4.0, "every": 120.0,
			"place": "at", "at": [-3.85, 2.4, -9.3], "reach": 9.0,
			"level": {"bind": "setting.candles", "map": {"none": 0.0, "few": 1.0, "many": 1.0}}}},
		{"system": "sound_bed", "id": "owl", "params": {"sound": "tawny_owl", "gain_db": -2.0, "film_db": -14.0,
			"every": 150.0, "jitter": 0.4, "place": "at", "at": [-28.0, 9.0, 6.0], "reach": 30.0}},
		{"system": "sound_bed", "id": "bell", "params": {"sound": "church_bell", "gain_db": -3.0, "pitch": 0.82,
			"place": "at", "at": [0.0, 24.0, 12.0], "reach": 18.0}}
	],
	"settings": [
		{"name": "candles", "type": "choice", "choices": ["none", "few", "many"], "labels": ["None", "A few", "Many"],
			"default": "few", "label": "Candles",
			"description": "None: the church by moonlight and the film alone. A few: two candle stands either side of the screen, the coronae over the nave and the votive lights. Many: four stands a side."}
	],
	"cues": [
		{"name": "candles_down", "stop_in": ["preshow", "ended"], "when": {"state": "starting"},
			"steps": [
				{"set": "light.house_lamps", "to": 0.2, "seconds": 7.0},
				{"set": "light.accent", "to": 0.3, "seconds": 9.0},
				{"set": "light.step_lights", "to": 0.35, "seconds": 9.0},
				{"set": "nave.rose_glow", "to": 0.12, "seconds": 6.0},
				{"set": "nave.window_glow", "to": 0.2, "seconds": 8.0}
			]},
		{"name": "candles_up", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]},
			"steps": [
				{"set": "light.house_lamps", "to": 1.0, "seconds": 5.0},
				{"set": "light.accent", "to": 1.0, "seconds": 6.0},
				{"set": "light.step_lights", "to": 1.0, "seconds": 6.0},
				{"release": "nave.rose_glow", "seconds": 5.0},
				{"release": "nave.window_glow", "seconds": 5.0}
			]},
		{"name": "bell_preshow", "when": {"every": 300.0}, "states": ["preshow"],
			"steps": [{"do": "bell.play"}]},
		{"name": "bell_after", "when": {"state": "ended"},
			"steps": [{"wait": 6.0}, {"do": "bell.play"}]}
	]
}
