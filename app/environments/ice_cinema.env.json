{
	"schema": 4,
	"name": "Ice cinema",
	"room": {"description": "A cinema of ice blocks with seats on hides: the walls glow in the film's colours, and an aurora swells outside in quiet scenes.", "ambient": 0.05, "screen_glow": 1.2, "category": "cinema"},
	"screen": {"center": [0.0, 1.7, -5.98], "size": [3.2, 1.8]},
	"acoustics": {"rt60": 0.6, "wet": 0.3},
	"systems": [
		{"system": "light", "params": {"spill": 4.5, "fill_top": [0.15, 0.19, 0.27], "fill_bottom": [0.06, 0.08, 0.11]}},
		{"system": "domestic", "id": "room", "params": {"style": "ice", "outside": "none", "window": "left",
			"window_width": 2.0}},
		{"system": "seats", "params": {"model": "hide"}},
		{"system": "sky", "params": {"latitude": 68.0, "day_of_year": 30.0, "hour": 23.0, "facing": 180.0,
			"milky_way": 0.4, "aurora_bearing": 90.0,
			"aurora": {"bind": "setting.aurora", "map": {"quiet": 0.15, "always": 0.8, "off": 0.0}}}},
		{"system": "atmosphere", "params": {"breath": 0.6, "fog": 0.25, "fog_height": 0.35,
			"fog_center": [0.0, 0.0, -1.5], "fog_size": [6.0, 9.0], "fog_layers": 2, "fog_walls": true,
			"fog_colour": [0.72, 0.8, 0.9]}}
	],
	"settings": [
		{"name": "aurora", "type": "choice", "choices": ["quiet", "always", "off"],
			"labels": ["In quiet scenes", "Always", "Off"], "default": "quiet", "label": "Aurora",
			"description": "The northern lights in the window: they swell in quiet scenes, glow all the time, or stay away."}
	],
	"cues": [
		{"name": "aurora_swells", "when": {"signal": "film.quiet", "above": 0.9, "for": 2.0},
			"requires": [{"setting": "aurora", "is": "quiet"}], "states": ["playing", "credits"],
			"steps": [{"set": "sky.aurora", "to": 1.0, "seconds": 8.0}]},
		{"name": "aurora_settles", "when": {"signal": "film.quiet", "below": 0.5},
			"steps": [{"release": "sky.aurora", "seconds": 12.0}]}
	]
}
