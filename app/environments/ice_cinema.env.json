{
	"schema": 4,
	"name": "Ice cinema",
	"room": {"description": "An ice hotel's cinema of sawn blocks and carvings under an ice vault: candles glowing inside the ice, hides on ice benches, the polar night and the northern lights outside.", "ambient": 0.05, "screen_glow": 1.2, "category": "cinema"},
	"screen": {"center": [0.0, 1.7, -5.98], "size": [3.2, 1.8]},
	"acoustics": {"reflect": [0.6, 0.6, 0.25, 0.6, 0.5, 0.4], "rt60": 0.9, "wet": 0.6, "late": 1.6},
	"systems": [
		{"system": "light", "params": {"spill": 0.2, "fill_top": [0.06, 0.06, 0.07], "fill_bottom": [0.07, 0.065, 0.065], "baked_fill": 0.9,
			"lamp_colour": [1.0, 0.62, 0.3], "lamp_energy": 4.0, "lamp_range": 3.0}},
		{"system": "domestic", "id": "room", "params": {"style": "ice", "outside": "none", "window": "left",
			"window_width": 2.0, "shell": "kit", "lamps": 0, "ceiling_light": 0.0}},
		{"system": "seats", "params": {"model": "hide", "upholstery": {"library": "cream_carpet", "color": [1.0, 0.97, 0.92], "tiling": 0.3, "spill": 0.03}}},
		{"system": "kit", "params": {"bake_lamps": 12, "flicker": 0.5, "pieces": [
			{"piece": "ice_shell"}, {"piece": "ice_screen"}, {"piece": "ice_benches"}, {"piece": "ice_outside"}]}},
		{"system": "sky", "params": {"latitude": 68.0, "day_of_year": 30.0, "hour": 23.0, "facing": 180.0,
			"milky_way": 0.4, "aurora_bearing": 90.0,
			"moon": 0.8, "moon_bearing": 124.0, "moon_altitude": 9.0, "moon_phase": 0.8, "moon_size": 1.8,
			"aurora": {"bind": "setting.aurora", "map": {"quiet": 0.15, "always": 0.8, "off": 0.0}}}},
		{"system": "atmosphere", "params": {"breath": 0.6, "fog": 0.2, "fog_height": 0.3,
			"fog_center": [0.0, 0.0, -1.5], "fog_size": [6.0, 9.0], "fog_layers": 1, "fog_walls": false,
			"fog_colour": [0.72, 0.8, 0.9]}},
		{"system": "weather", "params": {"falls": "snow", "mode": "light", "intensity": 0.7, "particles": 260,
			"wind": [-0.5, 0.25], "colour": [0.82, 0.86, 0.94],
			"areas": [{"min": [-4.6, 0.0, 3.8], "max": [0.4, 3.2, 7.5]}, {"min": [-8.0, 0.0, -5.0], "max": [-3.8, 3.0, 0.2]}]}},
		{"system": "acoustics", "params": {"preset": "ice"}},
		{"system": "sound_bed", "id": "huskies", "params": {"sound": "huskies", "every": 300.0, "place": "at",
			"at": [30.0, 1.0, 120.0], "reach": 150.0}},
		{"system": "sound_bed", "id": "wind", "params": {"sound": "wind", "gain_db": -3.0, "place": "at",
			"at": [-2.07, 1.1, 3.6], "reach": 4.0}},
		{"system": "sound_bed", "id": "creak", "params": {"sound": "ice_creak", "every": 240.0, "place": "at",
			"at": [2.8, 2.2, -2.5], "reach": 4.0}}
	],
	"settings": [
		{"name": "aurora", "type": "choice", "choices": ["quiet", "always", "off"],
			"labels": ["In quiet scenes", "Always", "Off"], "default": "quiet", "label": "Aurora",
			"description": "The northern lights in the window and the skylights: lively before the film and swelling in its quiet scenes, glowing all the time, or staying away."}
	],
	"cues": [
		{"name": "candles_down", "stop_in": ["preshow", "ended"], "when": {"state": "starting"},
			"steps": [
				{"set": "light.house_lamps", "to": 0.1, "seconds": 6.0},
				{"set": "light.accent", "to": 0.4, "seconds": 9.0},
				{"release": "sky.aurora", "seconds": 12.0}
			]},
		{"name": "candles_up", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]},
			"steps": [
				{"set": "light.house_lamps", "to": 1.0, "seconds": 5.0},
				{"set": "light.accent", "to": 1.0, "seconds": 6.0}
			]},
		{"name": "aurora_preshow", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]},
			"requires": [{"setting": "aurora", "is": "quiet"}],
			"steps": [{"set": "sky.aurora", "to": 0.75, "seconds": 15.0}]},
		{"name": "aurora_swells", "when": {"signal": "film.quiet", "above": 0.9, "for": 2.0},
			"requires": [{"setting": "aurora", "is": "quiet"}], "states": ["playing", "credits"],
			"steps": [{"set": "sky.aurora", "to": 1.0, "seconds": 8.0}]},
		{"name": "aurora_settles", "when": {"signal": "film.quiet", "below": 0.5}, "states": ["playing", "credits", "paused"],
			"steps": [{"release": "sky.aurora", "seconds": 12.0}]}
	]
}
