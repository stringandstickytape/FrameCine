			"parapet": false, "screen": "frame", "screen_size": [8.0, 4.5], "screen_bottom": 1.6,
			"rows_front": 2, "rows_back": 5, "row_pitch": 0.95, "seat_pitch": 0.6, "tier_rise": 0.42,
			"arc_deg": 120.0, "string_lights": false, "lunar": true,
			"frame": {"library": "dark_metal", "color": [0.12, 0.12, 0.13]}}},
		{"system": "dome_hall", "id": "dome", "params": {
			"has_floor": false, "seating": false, "outside": "none", "dome": "glass",
			"radius": 18.0, "centre_z": -9.0, "floor_y": -1.26, "drum_height": 0.8, "dome_height": 12.0,
			"lattice": "geodesic", "frequency": 6, "rib_phase": 0.0, "airlocks": 2, "trays": true,
			"lamps": 16, "lamp_colour": [0.85, 0.9, 1.0],
			"glass_colour": [0.08, 0.09, 0.1], "glass_reflect": 0.5, "glass_dust": 0.5,
			"drum": {"library": "concrete_panels", "color": [0.36, 0.35, 0.34]},
			"frame": {"library": "brushed_steel", "color": [0.4, 0.41, 0.42]}}},
		{"system": "sky", "params": {"mode": "space", "latitude": -30.0, "day_of_year": 200.0, "hour": 22.0,
			"facing": 180.0, "faint_stars": 4000, "milky_detail": 1.0,
			"milky_way": {"bind": "playback.playing", "range": [0.25, 0.6], "smooth": 3.0},
			"earth": true, "earth_detail": true, "earth_bearing": 192.0, "earth_altitude": 30.0, "earth_size": 5.0,
