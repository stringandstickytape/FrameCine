			"earth_turn": {"bind": "setting.earth_speed", "range": [6.0, 48.0]}}},
		{"system": "acoustics", "params": {"preset": "vacuum"}},
		{"system": "sound_bed", "id": "silence", "params": {"sound": "silence"}}
	],
	"settings": [
		{"name": "earth_speed", "type": "range", "min": 0.5, "max": 4.0, "step": 0.5, "default": 1.0,
			"format": "times", "label": "Earth's speed",
			"description": "How fast Earth turns in the sky. At 1 x it turns once in two hours, about once a film."}
