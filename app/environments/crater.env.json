{
	"schema": 4,
	"name": "Crater",
	"room": {"description": "A Moon base's cinema under a geodesic glass dome: Earth turns slowly over the screen, the crater's peaks catch the sun, and the Milky Way comes out when the lights go down.", "ambient": 0.03, "screen_glow": 1.0, "category": "cinema"},
	"screen": {"center": [0.0, 2.59, -11.4], "size": [8.0, 4.5]},
