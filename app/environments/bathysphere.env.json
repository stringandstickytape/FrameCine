{
	"schema": 4,
	"name": "Bathysphere",
	"room": {"description": "A glass dome on the sea floor: kelp and coral in the floodlights, schools of fish, glowing creatures drawn to the screen, a manta overhead, and in a quiet scene now and then a whale.", "ambient": 0.04, "screen_glow": 1.0, "category": "cinema"},
	"screen": {"center": [0.0, 3.25, -8.3], "size": [6.4, 3.6]},
	"acoustics": {"reflect": [0.55, 0.55, 0.3, 0.6, 0.55, 0.55], "rt60": 0.9, "wet": 0.45},
	"systems": [
		{"system": "light", "params": {"fill_top": [0.32, 0.55, 0.62], "fill_bottom": [0.05, 0.09, 0.11],
			"lamp_colour": [1.0, 0.72, 0.45], "spill": 3.2, "caustic_scale": 1.3,
			"caustics": {"bind": "setting.depth", "map": {"shallow": 1.0, "twilight": 0.3, "abyss": 0.0}, "smooth": 3.0}}},
		{"system": "dome_hall", "id": "hall", "params": {
			"radius": 9.0, "centre_z": -1.5, "drum_height": 1.3, "dome_height": 7.5, "dome": "glass",
			"ribs": 12, "rings": 3, "outside": "water",
			"water_top": [0.02, 0.09, 0.16], "water_deep": [0.0, 0.008, 0.02],
			"outside_glow": {"bind": "playback.playing", "range": [0.7, 0.45], "smooth": 3.0},
			"rows_front": 2, "rows_back": 3, "row_depth": 1.2, "seat_pitch": 0.72, "arc_deg": 100.0,
			"seat_model": "plush", "screen_size": [6.4, 3.6], "screen_z": -8.3, "screen_bottom": 1.45,
			"floor": {"library": "oak_planks", "color": [0.36, 0.3, 0.24]},
			"drum": {"library": "dark_metal", "color": [0.16, 0.18, 0.19]},
			"frame": {"library": "brass", "color": [0.55, 0.42, 0.22]},
			"seat_cover": {"library": "velvet", "color": [0.08, 0.26, 0.3], "tiling": 0.22},
			"seat_frame": {"library": "brass", "color": [0.35, 0.27, 0.15]},
			"glass_colour": [0.06, 0.12, 0.15], "lamps": 12, "lamp_colour": [1.0, 0.74, 0.48],
			"rib_phase": 0.5, "seabed": true, "rocks": 30, "coral": 28, "fronds": 90, "wreck": true, "vent": true,
			"snow": 1800, "floodlights": 4, "portholes": 10, "rivets": true, "gauges": 6, "console": true, "hatch": true,
			"gauge": {"bind": "film.bass", "smooth": 0.3},
			"depth": {"bind": "setting.depth", "map": {"shallow": 0.0, "twilight": 0.5, "abyss": 1.0}, "smooth": 3.0}}},
		{"system": "life", "id": "fish", "params": {"creature": "fish", "count": 40, "schooling": 0.8,
			"region": {"min": [-14.0, 1.5, -14.0], "max": [-6.5, 7.0, -9.0]},
			"attraction": {"bind": "film.brightness", "range": [0.2, 0.9], "smooth": 2.0}}},
		{"system": "life", "id": "shoal", "params": {"creature": "fish", "count": 28, "size": 0.8, "schooling": 0.6,
			"colour": [0.42, 0.5, 0.48],
			"region": {"min": [6.5, 2.0, -14.0], "max": [14.0, 7.5, -9.0]},
			"attraction": {"bind": "film.brightness", "range": [0.2, 0.9], "smooth": 2.0}}},
		{"system": "life", "id": "glow", "params": {"creature": "jelly", "count": 16, "size": 2.0,
			"region": {"min": [-8.0, 0.5, -14.0], "max": [8.0, 8.5, -10.8]},
			"attraction": {"bind": "film.brightness", "range": [0.3, 1.0], "smooth": 2.0},
			"colour": {"bind": "film.colour", "strength": 0.5, "base": "#59bfff", "smooth": 1.0},
			"glow": {"bind": "film.quiet", "range": [0.8, 1.6], "smooth": 3.0}}},
		{"system": "life", "id": "manta", "params": {"creature": "ray", "every": 150.0, "size": 1.5,
			"region": {"min": [-20.0, 11.0, -20.0], "max": [20.0, 14.0, 16.0]}}},
		{"system": "life", "id": "whale", "params": {"creature": "whale", "size": 0.8, "voice_db": -4.0, "colour": [0.45, 0.55, 0.65],
			"path": [[-15.0, 13.0, -17.0], [0.0, 13.5, -19.0], [15.0, 12.5, -17.0]]}},
		{"system": "acoustics", "params": {"preset": "hull", "rt60": 0.9}},
		{"system": "sound_bed", "id": "creak_left", "params": {"sound": "hull_creak", "every": 180.0, "place": "at",
			"at": [-8.5, 1.8, -1.5], "reach": 9.0}},
		{"system": "sound_bed", "id": "creak_right", "params": {"sound": "hull_creak", "every": 180.0, "place": "at",
			"at": [8.5, 1.8, -1.5], "reach": 9.0}},
		{"system": "sound_bed", "id": "deep", "params": {"sound": "deep_hum", "gain_db": -4.0}},
		{"system": "sound_bed", "id": "vent", "params": {"sound": "bubbles", "gain_db": -3.0, "place": "at",
			"at": [11.9, 4.0, 5.9], "reach": 8.0}},
		{"system": "sound_bed", "id": "sonar", "params": {"sound": "sonar", "gain_db": -2.0, "place": "at",
			"at": [0.0, 1.0, 7.0], "reach": 6.0}},
		{"system": "sound_bed", "id": "far_song", "params": {"sound": "whale", "gain_db": -6.0, "place": "at",
			"at": [-22.0, 12.0, 10.0], "reach": 30.0}}
	],
	"settings": [
		{"name": "depth", "type": "choice", "choices": ["shallow", "twilight", "abyss"],
			"labels": ["Sunlit shallows", "Twilight", "Abyss"], "default": "twilight",
			"label": "Depth", "description": "How deep the dome lies: sunlit shallows with shafts of light and caustics, the blue twilight, or the black abyss where only the lamps and what glows show."},
		{"name": "flood_level", "type": "range", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3,
			"format": "percent", "label": "Lights outside in the film",
			"description": "How bright the floodlights on the sea floor stay once the film has started. Before the film they are full."},
		{"name": "whale", "type": "choice", "choices": ["never", "rare", "sometimes"],
			"labels": ["Never", "Rarely", "Sometimes"], "default": "rare",
			"label": "Whale", "description": "How often a whale swims past behind the screen in a quiet scene."}
	],
	"cues": [
		{"name": "dim", "stop_in": ["preshow", "ended"], "when": {"state": "starting"}, "requires": [{"setting": "dim"}],
			"steps": [{"set": "light.house_lamps", "to": 0.12, "seconds": 4.0}, {"wait": 1.5},
				{"set": "hall.flood", "to": {"setting": "flood_level"}, "seconds": 6.0}]},
		{"name": "lights_up", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]},
			"steps": [{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0},
				{"set": "hall.flood", "to": 1.0, "seconds": 5.0}]},
		{"name": "ping", "when": {"every": 12.0}, "states": ["preshow", "paused", "ended"],
			"steps": [{"do": "sonar.play"}]},
		{"name": "first_ping", "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [{"do": "sonar.play"}, {"set": "hall.sonar", "to": 0.35, "seconds": 6.0}]},
		{"name": "scope_up", "when": {"state": ["preshow", "paused", "ended"]},
			"steps": [{"set": "hall.sonar", "to": 1.0, "seconds": 3.0}]},
		{"name": "far_song", "when": {"signal": "film.quiet", "above": 0.9, "for": 8.0}, "states": ["playing"],
			"requires": [{"setting": "whale", "is": "sometimes"}], "chance": 0.5, "cooldown": 600.0,
			"steps": [{"do": "far_song.play"}]},
		{"name": "far_song_rare", "when": {"signal": "film.quiet", "above": 0.9, "for": 8.0}, "states": ["playing"],
			"requires": [{"setting": "whale", "is": "rare"}], "chance": 0.3, "cooldown": 1200.0,
			"steps": [{"do": "far_song.play"}]},
		{"name": "whale_rare", "when": {"signal": "film.quiet", "above": 0.9, "for": 4.0}, "states": ["playing"],
			"requires": [{"setting": "whale", "is": "rare"}], "chance": 0.3, "cooldown": 1800.0,
			"steps": [{"do": "whale.pass"}]},
		{"name": "whale_sometimes", "when": {"signal": "film.quiet", "above": 0.9, "for": 4.0}, "states": ["playing"],
			"requires": [{"setting": "whale", "is": "sometimes"}], "chance": 0.7, "cooldown": 900.0,
			"steps": [{"do": "whale.pass"}]}
	],
	"timeline": {"starting_seconds": 8.0, "credits_minutes": 6.0},
	"audio": {"level_db": 0.0, "pause_rise_db": 3.0}
}
