{
	"schema": 4,
	"name": "Cinema",
	"room": {"description": "The converted cinema: rows on a rake, curtains that part when the film starts, and the house lights going down.", "ambient": 0.05, "screen_glow": 1.0, "curtains": true, "category": "cinema"},
	"screen": {"center": [0.0, 1.6, -13.8], "size": [12.0, 5.0]},
	"acoustics": {"reflect": [0.35, 0.35, 0.15, 0.2, 0.2, 0.3], "rt60": 0.8, "wet": 0.5, "late": 1.8},
	"systems": [
		{"system": "light"},
		{"system": "auditorium", "id": "hall"},
		{"system": "screen_frame"},
		{"system": "showing"},
		{"system": "acoustics", "params": {"preset": "cinema"}}
	],
	"settings": [
		{"name": "house_level", "type": "range", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.2,
			"format": "percent", "label": "House lights in the film",
			"description": "How bright the house lamps stay once the film has started."}
	],
	"cues": [
		{"name": "ritual", "stop_in": ["preshow", "ended"], "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [
				{"sound": "chime", "gain_db": -6.0, "at": [0.0, 3.0, -12.0]},
				{"set": "light.house_lamps", "to": 0.5, "seconds": 1.5},
				{"do": "showing.open_curtains", "args": {"seconds": 3.5}},
				{"wait": 2.0},
				{"set": "light.house_lamps", "to": {"setting": "house_level"}, "seconds": 5.0}
			]},
		{"name": "dim", "stop_in": ["preshow", "ended"], "when": {"state": "starting"}, "requires": [{"setting": "ritual", "is": false}],
			"steps": [{"set": "light.house_lamps", "to": {"setting": "house_level"}, "seconds": 3.0}]},
		{"name": "lights_up", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]},
			"steps": [{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0}]}
	],
	"timeline": {"starting_seconds": 8.0, "credits_minutes": 6.0},
	"audio": {"level_db": 0.0, "pause_rise_db": 3.0}
}
