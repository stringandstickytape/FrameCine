{
	"schema": 4,
	"name": "Screening room 1962",
	"room": {"description": "A private screening room, 1962: walnut walls, club chairs, a pool glowing through the window, and a painting that slides up to show the screen.", "ambient": 0.06, "screen_glow": 1.0, "category": "cinema"},
	"screen": {"center": [0.0, 1.68, -5.14], "size": [2.6, 1.46]},
	"acoustics": {"rt60": 0.45, "wet": 0.3},
	"systems": [
		{"system": "light"},
		{"system": "domestic", "id": "room", "params": {"style": "walnut_1962", "outside": "none"}},
		{"system": "seats", "params": {"model": "club_chair",
			"upholstery": {"library": "brown_leather", "color": [0.36, 0.2, 0.11]},
			"frame": {"library": "walnut_veneer", "color": [0.2, 0.12, 0.07]}, "variation": 0.5, "seed": 1962}},
		{"system": "sky", "params": {"latitude": 34.0, "day_of_year": 230, "hour": 22.0, "facing": 180.0,
			"dusk": 0.9, "faint_stars": 900, "milky_way": 0.35}},
		{"system": "vista", "params": {"items": [
			{"shape": "pool", "azimuth": -58.0, "distance": 11.0, "size": 1.2},
			{"shape": "hills", "colour": "#10141c"}]}},
		{"system": "acoustics", "params": {"preset": "small_room", "rt60": 0.45}},
		{"system": "sound_bed", "id": "fire", "params": {"sound": "fire", "place": "at", "at": [2.4, 0.56, -1.66],
			"reach": 2.5}},
		{"system": "sound_bed", "id": "pump", "params": {"sound": "hum", "place": "at", "at": [-3.6, 0.6, -2.2],
			"reach": 3.0}},
		{"system": "sound_bed", "id": "bells", "params": {"sound": "three_bells", "film_db": -4.0}}
	],
	"settings": [
		{"name": "house_level", "type": "range", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.15,
			"format": "percent", "label": "Wall lamps in the film",
			"description": "How bright the brass wall lamps stay once the film has started."}
	],
	"cues": [
		{"name": "ritual", "stop_in": ["preshow", "ended"], "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [
				{"do": "bells.play"},
				{"set": "light.house_lamps", "to": 0.5, "seconds": 1.5},
				{"set": "room.painting_open", "to": 1.0, "seconds": 7.0},
				{"wait": 2.0},
				{"set": "light.house_lamps", "to": {"setting": "house_level"}, "seconds": 4.0}
			]},
		{"name": "dim", "stop_in": ["preshow", "ended"], "when": {"state": "starting"}, "requires": [{"setting": "ritual", "is": false}],
			"steps": [
				{"set": "room.painting_open", "to": 1.0, "seconds": 3.0},
				{"set": "light.house_lamps", "to": {"setting": "house_level"}, "seconds": 3.0}
			]},
		{"name": "painting_away", "stop_in": ["preshow", "ended"], "when": {"state": ["playing", "intermission", "credits"]},
			"steps": [
				{"set": "room.painting_open", "to": 1.0, "seconds": 4.0},
				{"set": "light.house_lamps", "to": {"setting": "house_level"}, "seconds": 3.0}
			]},
		{"name": "lights_up", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]},
			"steps": [{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0}]},
		{"name": "painting_down", "stop_in": ["starting", "playing"], "when": {"state": ["preshow", "ended"]}, "requires": [{"setting": "ritual"}],
			"steps": [{"wait": 1.0}, {"set": "room.painting_open", "to": 0.0, "seconds": 6.0}]}
	],
	"timeline": {"starting_seconds": 8.0, "credits_minutes": 6.0},
	"audio": {"level_db": 0.0, "pause_rise_db": 3.0}
}
