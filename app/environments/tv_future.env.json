{
	"schema": 4,
	"name": "TV tomorrow - the wall",
	"room": {"description": "A calm bare room some day to come: no set at all, a part of the wall wakes and becomes the picture.", "ambient": 0.04, "screen_glow": 1.0, "category": "tv"},
	"screen": {"center": [0.0, 1.0, -3.78], "size": [1.44, 0.81]},
	"acoustics": {"reflect": [0.5, 0.5, 0.35, 0.45, 0.35, 0.45], "rt60": 0.7, "wet": 0.42, "late": 1.7},
	"systems": [
		{"system": "light", "params": {"fill_top": [0.56, 0.58, 0.62], "fill_bottom": [0.18, 0.18, 0.2],
			"lamp_energy": 2.0}},
		{"system": "domestic", "id": "room", "params": {
			"style": "plain", "half_width": 3.2, "front_z": -3.8, "back_z": 2.2, "height": 2.7,
			"screen": "wall", "screen_size": [1.44, 0.81], "screen_bottom": 0.595,
			"window": "left", "window_width": 2.6, "outside": "none",
			"door": "back", "heater": "none", "lamps": 0,
			"seat_model": "club", "rows_front": 0, "rows_back": 0, "seats_per_row": 3, "seat_pitch": 0.66,
			"walls": {"library": "smooth_plaster", "color": [0.7, 0.69, 0.66]},
			"floor": {"library": "grey_oak_floor", "color": [0.72, 0.68, 0.62]},
			"ceiling": {"library": "smooth_plaster", "color": [0.86, 0.86, 0.85], "spill": 1.0},
			"trim": {"library": "smooth_plaster", "color": [0.78, 0.77, 0.74]},
			"screen_surface": {"library": "smooth_plaster", "color": [0.7, 0.69, 0.66]}}},
		{"system": "kit", "params": {
			"fabric": {"library": "felt", "color": [0.66, 0.64, 0.6]},
			"pieces": [
				{"piece": "rug", "at": [0.0, 0.0, -0.9], "size": [3.0, 0.012, 2.4], "accent": [0.66, 0.64, 0.6]}]}},
		{"system": "seats", "params": {
			"model": "settee",
			"upholstery": {"library": "linen", "color": [0.7, 0.68, 0.63]},
			"frame": {"library": "oak_veneer", "color": [0.6, 0.5, 0.38]}}},
		{"system": "sky", "params": {"facing": 0.0, "dusk": 1.0, "clouds": 0.1,
			"stars": {"bind": "setting.stars", "range": [0.0, 1.0]}, "milky_way": 0.3}},
		{"system": "presentation", "params": {"preset": "none"}},
		{"system": "acoustics", "params": {"preset": "small_room", "rt60": 0.3}}
	],
	"settings": [
		{"name": "stars", "type": "range", "min": 0.0, "max": 1.0, "step": 0.1, "default": 0.8,
			"format": "percent", "label": "Stars in the window",
			"description": "How many stars the night shows through the long window."}
	],
	"cues": [
		{"name": "wall_wakes", "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [
				{"set": "presentation.gain", "to": 0.5, "seconds": 0.3},
				{"wait": 0.4},
				{"set": "presentation.gain", "to": 1.0, "seconds": 4.0, "ease": "out"},
				{"wait": 4.5},
				{"release": "presentation.gain", "seconds": 0.5}
			]}
	],
	"timeline": {"starting_seconds": 6.0}
}
