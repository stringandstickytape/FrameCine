				{"at": [-0.55, 0.0, 1.65], "turn": -10.0, "model": "club_chair"}],
			"upholstery": {"library": "herringbone_upholstery", "color": [0.4, 0.3, 0.2]},
			"frame": {"library": "walnut_veneer", "color": [0.22, 0.13, 0.07]}}},
		{"system": "sky", "params": {"facing": 0.0, "glow_bearing": 268.0, "dusk": 0.85, "clouds": 0.7,
			"stars": 0.3, "milky_way": 0.0}},
		{"system": "vista", "params": {"items": [{"shape": "hills", "azimuth": -90.0, "spread": 100.0}]}},
		{"system": "weather", "params": {"mode": "changing", "cycle_minutes": 30.0, "cycle_start": 0.25,
