			"ceiling": {"library": "smooth_plaster", "color": [0.84, 0.8, 0.72], "spill": 1.0},
			"trim": {"library": "oak_veneer", "color": [0.32, 0.2, 0.11]},
			"surround": {"library": "red_brick", "color": [0.5, 0.33, 0.24]},
