		{"system": "life", "id": "cat", "params": {"creature": "cat",
			"path": [[1.3, 0.0, -1.15], [1.3, 0.0, -0.15]]}},
		{"system": "presentation", "params": {
			"preset": "fireside_1953", "gain": 1.0,
			"snow": {"bind": "setting.aerial", "range": [0.0, 0.6]}}}
	],
	"settings": [
		{"name": "aerial", "type": "range", "min": 0.0, "max": 0.6, "step": 0.02, "default": 0.22,
			"format": "percent", "label": "Snow from the aerial",
			"description": "Snow on the picture from a weak signal on the roof aerial. At the bottom: a clean picture."},
		{"name": "fire", "type": "bool", "default": true, "label": "Fire in the grate",
			"description": "A coal fire burns in the grate, and the cat likes the hearth."}
	],
	"cues": [
		{"name": "warm_up", "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [
				{"set": "presentation.gain", "to": 0.55, "seconds": 0.3},
				{"wait": 0.6},
				{"set": "presentation.gain", "to": 1.0, "seconds": 6.0, "ease": "out"},
				{"wait": 6.5},
				{"release": "presentation.gain", "seconds": 0.5}
			]},
		{"name": "lamps_down", "when": {"state": ["starting", "playing"]},
			"steps": [{"set": "light.house_lamps", "to": 0.25, "seconds": 3.0}]},
		{"name": "lamps_up", "when": {"state": ["preshow", "ended"]},
			"steps": [{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0}]}
	],
	"timeline": {"starting_seconds": 8.0}
