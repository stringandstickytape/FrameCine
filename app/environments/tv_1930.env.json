{
	"schema": 4,
	"name": "TV 1930 - glowing box",
	"room": {"ambient": 0.03, "screen_glow": 1.2, "category": "tv"},
	"screen": {"center": [0.0, 1.0525, -0.9], "size": [0.3, 0.225]},
	"acoustics": {"reflect": [0.35, 0.35, 0.3, 0.4, 0.2, 0.35], "rt60": 0.45, "wet": 0.3},
	"systems": [
		{"system": "light", "params": {"fill_top": [0.42, 0.32, 0.24], "fill_bottom": [0.14, 0.1, 0.08],
			"lamp_energy": 1.6, "spill": 3.5}},
		{"system": "domestic", "id": "room", "params": {
			"style": "plain", "half_width": 2.0, "front_z": -1.4, "back_z": 2.6, "height": 2.6,
			"screen": "telly", "screen_size": [0.3, 0.225], "screen_bottom": 0.94,
			"window": "left", "window_width": 1.1, "outside": "glow",
			"outside_top": [0.02, 0.03, 0.06], "outside_bottom": [0.05, 0.06, 0.1], "outside_glow": 0.35,
			"door": "back", "heater": "fireplace",
			"fire": {"bind": "setting.fire", "map": {"true": 1.0, "false": 0.0}, "smooth": 1.5},
			"lamps": 1, "lamp_colour": [1.0, 0.66, 0.38],
			"seat_model": "club", "rows_front": 0, "rows_back": 0, "seats_per_row": 1,
			"walls": {"library": "painted_wall", "color": [0.46, 0.4, 0.3]},
			"floor": {"library": "herringbone_parquet", "color": [0.36, 0.24, 0.14]},
			"ceiling": {"library": "smooth_plaster", "color": [0.78, 0.74, 0.66], "spill": 1.0},
			"trim": {"library": "walnut_veneer", "color": [0.28, 0.17, 0.09]},
			"surround": {"library": "red_brick", "color": [0.42, 0.28, 0.2]},
			"telly_material": {"library": "walnut_veneer", "color": [0.36, 0.22, 0.11]}}},
		{"system": "seats", "params": {
			"places": [
				{"at": [-1.05, 0.0, 0.35], "turn": -38.0, "model": "club_chair"},
				{"at": [1.0, 0.0, 0.4], "turn": 36.0, "model": "club_chair"}],
			"upholstery": {"library": "velvet", "color": [0.32, 0.16, 0.1], "tiling": 0.3},
			"frame": {"library": "walnut_veneer", "color": [0.2, 0.12, 0.07]}}},
		{"system": "presentation", "params": {
			"preset": "glowbox_1930", "weak": 0.2,
			"mech_lines": {"bind": "setting.lines", "map": {"as_it_was": 30, "sharper": 60, "sharpest": 120}}}}
	],
	"settings": [
		{"name": "lines", "type": "choice", "choices": ["as_it_was", "sharper", "sharpest"],
			"labels": ["30 lines", "60 lines", "120 lines"], "default": "as_it_was",
			"label": "Lines in the picture",
			"description": "The set drew its picture in 30 glowing lines. More lines show the film more clearly than it ever could."},
		{"name": "fire", "type": "bool", "default": true, "label": "Fire in the grate",
			"description": "A coal fire burns in the grate. Off: the grate is cold and the set's glow lights the room."}
	],
	"cues": [
		{"name": "tuning_in", "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [
				{"set": "presentation.weak", "to": 1.0, "seconds": 0.3},
				{"wait": 0.5},
				{"set": "presentation.weak", "to": 0.2, "seconds": 6.0, "ease": "out"},
				{"wait": 6.5},
				{"release": "presentation.weak", "seconds": 0.5}
			]},
		{"name": "lamps_down", "when": {"state": ["starting", "playing"]},
			"steps": [{"set": "light.house_lamps", "to": 0.15, "seconds": 3.0}]},
		{"name": "lamps_up", "when": {"state": ["preshow", "ended"]},
			"steps": [{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0}]}
	],
	"timeline": {"starting_seconds": 8.0}
}
