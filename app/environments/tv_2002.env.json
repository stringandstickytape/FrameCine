{
	"schema": 4,
	"name": "TV 2002 - rear projection",
	"room": {"description": "A lounge in 2002: a big deep rear projection set filling the end of the room, a leather sofa, a glass coffee table.", "ambient": 0.05, "screen_glow": 1.0, "category": "tv"},
	"screen": {"center": [0.0, 0.915, -3.1], "size": [1.12, 0.63]},
	"acoustics": {"reflect": [0.35, 0.35, 0.3, 0.4, 0.2, 0.35], "rt60": 0.45, "wet": 0.3},
	"systems": [
		{"system": "light", "params": {"fill_top": [0.7, 0.64, 0.56], "fill_bottom": [0.22, 0.2, 0.17],
			"lamp_energy": 2.2}},
		{"system": "domestic", "id": "room", "params": {
			"style": "plain", "half_width": 3.0, "front_z": -3.77, "back_z": 2.4, "height": 2.5,
			"screen": "telly", "telly": "rear_projection", "telly_aspect": "wide", "screen_size": [1.12, 0.63],
			"screen_bottom": 0.6,
			"window": "left", "window_width": 2.0, "outside": "none",
			"door": "back", "heater": "radiator",
			"lamps": 1, "lamp_colour": [1.0, 0.8, 0.6],
			"seat_model": "club", "rows_front": 0, "rows_back": 0, "seats_per_row": 3, "seat_pitch": 0.64,
			"walls": {"library": "painted_wall", "color": [0.8, 0.74, 0.62]},
			"floor": {"library": "cream_carpet", "color": [0.66, 0.6, 0.5]},
			"ceiling": {"library": "smooth_plaster", "color": [0.9, 0.9, 0.88], "spill": 1.0},
			"trim": {"library": "oak_veneer", "color": [0.5, 0.38, 0.26]},
			"telly_material": {"library": "dark_metal", "color": [0.11, 0.11, 0.12]}}},
		{"system": "kit", "params": {
			"tin": {"library": "brushed_steel", "color": [0.66, 0.66, 0.66], "tiling": 0.5},
			"glass_colour": [0.5, 0.66, 0.64],
			"pieces": [
				{"piece": "glass_table", "at": [0.0, 0.0, -1.05], "size": [1.1, 0.4, 0.6]},
				{"piece": "floor_lamp", "at": [2.55, 0.0, -0.4], "size": [0.3, 1.6, 0.3], "colour": [1.0, 0.86, 0.66]},
				{"piece": "ferns", "at": [-2.5, 0.0, -3.0], "scale": 1.1}]}},
		{"system": "seats", "params": {
			"model": "settee",
			"places": [{"at": [1.8, 0.0, -0.9], "turn": 45.0, "model": "club_chair"}],
			"upholstery": {"library": "black_leather", "color": [0.1, 0.09, 0.09]},
			"frame": {"library": "black_leather", "color": [0.08, 0.075, 0.075]}}},
		{"system": "sky", "params": {"facing": 0.0, "glow_bearing": 280.0, "dusk": 0.8, "clouds": 0.4,
			"stars": 0.5, "milky_way": 0.0}},
		{"system": "vista", "params": {"items": [{"shape": "hills", "azimuth": -90.0, "spread": 120.0}]}},
		{"system": "presentation", "params": {
			"preset": "projection_2002", "starts_off": true,
			"gain": {"bind": "setting.brightness", "range": [0.8, 1.1]}}},
		{"system": "acoustics", "params": {"preset": "small_room"}},
		{"system": "sound_bed", "id": "fan", "params": {"sound": "hum", "place": "at", "at": [0.0, 0.4, -3.4],
			"reach": 2.0, "gain_db": -3.0}}
	],
	"settings": [
		{"name": "lamps", "type": "range", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.25,
			"format": "percent", "label": "Wall lamps in the film",
			"description": "How bright the wall lamps stay once the film has started."},
		{"name": "brightness", "type": "range", "min": 0.8, "max": 1.1, "step": 0.05, "default": 0.95,
			"format": "times", "label": "Lamp in the set",
			"description": "The projection lamp inside the set: an old lamp makes a dimmer picture."}
	],
	"cues": [
		{"name": "switch_on", "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [{"do": "presentation.switch_on"}]},
		{"name": "switch_off", "when": {"state": "ended"},
			"steps": [{"do": "presentation.switch_off"}]},
		{"name": "lamps_down", "when": {"state": ["starting", "playing"]},
			"steps": [{"set": "light.house_lamps", "to": {"setting": "lamps"}, "seconds": 3.0}]},
		{"name": "lamps_up", "when": {"state": ["preshow", "ended"]},
			"steps": [{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0}]}
	],
	"timeline": {"starting_seconds": 8.0}
}
