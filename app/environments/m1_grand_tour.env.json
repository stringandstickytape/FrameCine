			"default": "golden",
			"label": "Time of day",
			"description": "Fixed lighting from crisp British morning to late night, or smooth progression across the drive."
		},
		{
			"name": "weather",
			"type": "choice",
			"choices": ["mixed", "clear", "overcast", "fog", "rain", "storm"],
			"labels": ["Mixed (British drive)", "Clear", "Overcast", "Valley mist & fog", "Steady rain", "Thunderstorm"],
			"default": "mixed",
