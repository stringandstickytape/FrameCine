			"label": "Direction",
			"description": "Cruise northbound from London towards Yorkshire, or southbound back towards London."
		},
		{
			"name": "trim",
			"type": "choice",
			"choices": ["saddle", "beluga", "oxblood"],
			"labels": ["Saddle & Burr Walnut", "Beluga & Dark Walnut", "Oxblood & Dark Walnut"],
			"default": "saddle",
