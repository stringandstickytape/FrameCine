{
	"schema": 4,
	"name": "TV 1987 - rented tape",
	"room": {"ambient": 0.05, "screen_glow": 1.0, "category": "tv"},
	"screen": {"center": [0.0, 0.9225, -1.5], "size": [0.54, 0.405]},
	"acoustics": {"reflect": [0.3, 0.3, 0.3, 0.35, 0.15, 0.35], "rt60": 0.4, "wet": 0.28},
	"systems": [
		{"system": "light", "params": {"fill_top": [0.66, 0.54, 0.42], "fill_bottom": [0.2, 0.16, 0.12],
			"lamp_energy": 2.2}},
		{"system": "domestic", "id": "room", "params": {
			"style": "plain", "half_width": 2.8, "front_z": -2.0, "back_z": 2.8, "height": 2.45,
			"screen": "telly", "screen_size": [0.54, 0.405], "screen_bottom": 0.72,
			"window": "left", "window_width": 1.5, "outside": "none",
			"door": "back", "heater": "fireplace",
			"lamps": 1, "lamp_colour": [1.0, 0.78, 0.55],
			"seat_model": "club", "rows_front": 0, "rows_back": 0, "seats_per_row": 3, "seat_pitch": 0.9,
			"walls": {"library": "painted_wall", "color": [0.7, 0.64, 0.56]},
			"floor": {"library": "woven_carpet", "color": [0.36, 0.14, 0.12]},
			"ceiling": {"library": "smooth_plaster", "color": [0.88, 0.86, 0.82], "spill": 1.0},
			"trim": {"library": "oak_veneer", "color": [0.34, 0.22, 0.13]},
			"surround": {"library": "painted_brick", "color": [0.62, 0.56, 0.5]},
			"telly_material": {"library": "dark_metal", "color": [0.08, 0.08, 0.085]}}},
		{"system": "kit", "params": {
			"plaster": {"library": "dark_metal", "color": [0.1, 0.1, 0.11]},
			"wood": {"library": "dark_metal", "color": [0.05, 0.05, 0.055]},
			"pieces": [
				{"piece": "ferns", "at": [2.2, 0.0, -1.45], "scale": 0.8},
				{"piece": "partition", "at": [0.0, 0.5, -1.61], "size": [0.43, 0.09, 0.32],
					"colour": [0.1, 0.1, 0.11]}]}},
		{"system": "seats", "params": {
			"places": [{"at": [1.65, 0.0, -0.25], "turn": 38.0, "model": "club_chair"}],
			"upholstery": {"library": "melange_fabric", "color": [0.55, 0.47, 0.36]},
			"frame": {"library": "oak_veneer", "color": [0.3, 0.2, 0.12]}}},
		{"system": "sky", "params": {"facing": 0.0, "dusk": 1.0, "clouds": 0.8, "stars": 0.2, "milky_way": 0.0}},
		{"system": "vista", "params": {"items": [{"shape": "hills", "azimuth": -90.0, "spread": 110.0}]}},
		{"system": "weather", "params": {"mode": "changing", "cycle_minutes": 24.0, "cycle_start": 0.35,
			"falls": "rain", "particles": 500,
			"areas": [{"min": [-8.0, 0.0, -3.5], "max": [-3.1, 4.0, 1.8]}],
			"pane": true, "pane_center": [-2.86, 1.55, -0.84], "pane_size": [1.5, 1.3], "pane_yaw": 90.0}},
		{"system": "presentation", "params": {
			"preset": "rewinder_1987",
			"tape_noise": {"bind": "setting.tape", "map": {"fresh": 0.12, "rented": 0.4, "worn": 0.75}},
			"chroma_bleed": {"bind": "setting.tape", "map": {"fresh": 0.3, "rented": 0.6, "worn": 0.85}},
			"head_switch": {"bind": "setting.tape", "map": {"fresh": 0.35, "rented": 0.7, "worn": 1.0}}}}
	],
	"settings": [
		{"name": "tape", "type": "choice", "choices": ["fresh", "rented", "worn"],
			"labels": ["Fresh", "Rented", "Worn out"], "default": "rented",
			"label": "The tape",
			"description": "How many times the tape has been played: noise, smeared colour and the tear at the bottom."},
		{"name": "lamps", "type": "range", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3,
			"format": "percent", "label": "Wall lamps in the film",
			"description": "How bright the wall lamps stay once the film has started."}
	],
	"cues": [
		{"name": "tape_start", "when": {"state": "starting"}, "requires": [{"setting": "ritual"}],
			"steps": [{"do": "presentation.glitch", "args": {"seconds": 1.5}}]},
		{"name": "lamps_down", "when": {"state": ["starting", "playing"]},
			"steps": [{"set": "light.house_lamps", "to": {"setting": "lamps"}, "seconds": 3.0}]},
		{"name": "lamps_up", "when": {"state": ["preshow", "ended"]},
			"steps": [{"set": "light.house_lamps", "to": 1.0, "seconds": 4.0}]}
	],
	"timeline": {"starting_seconds": 8.0}
}
