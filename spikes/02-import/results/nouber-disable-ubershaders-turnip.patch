# NOUBER diagnostic (spike 02): disable ubershaders on Turnip, Mobile + Forward+.
# Result on the Steam Frame: 'Ubershaders: Disabled' printed, meshes still not drawn. Reverted from the tree.
# Apply on top of the spike 02 tree with: git apply nouber-disable-ubershaders-turnip.patch
--- a/drivers/vulkan/rendering_device_driver_vulkan.cpp
+++ b/drivers/vulkan/rendering_device_driver_vulkan.cpp
@@ -752,6 +752,14 @@
 				p_device_properties.vendorID == RenderingContextDriver::Vendor::VENDOR_QUALCOMM &&
 				strstr(p_driver_properties->driverInfo, "Compiler Version: EV031.32.02.") != nullptr;
 	}
+
+	// FRAME WORKAROUND (steam-frame-vr-video-player, spike 02): on the Steam Frame (Adreno 750, Mesa Turnip 26.3-devel),
+	// meshes don't draw in either renderer while full-screen passes (sky) do. Disable ubershaders on Turnip to test whether
+	// the ubershader pipelines are the cause. Diagnostic variant; remove or narrow once the cause is known.
+	const bool is_turnip = (p_driver_properties != nullptr && p_driver_properties->driverID == VK_DRIVER_ID_MESA_TURNIP) || strstr(p_device_properties.deviceName, "Turnip") != nullptr;
+	if (is_turnip) {
+		driver_workarounds.disable_ubershaders = true;
+	}
 }
 
