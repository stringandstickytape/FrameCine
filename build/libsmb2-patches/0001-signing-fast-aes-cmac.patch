+/* FIPS-197 AES-128 key expansion: 11 round keys. */
+static void
+cmac_expand_key(const uint8_t key[16], uint8_t rk[176])
+{
+        static const uint8_t rcon[10] = { 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36 };
+        int i, j;
+
+        memcpy(rk, key, 16);
+        for (i = 4; i < 44; i++) {
+                uint8_t t[4];
+                memcpy(t, rk + (i - 1) * 4, 4);
+                if (i % 4 == 0) {
+                        uint8_t u = t[0];
+                        t[0] = cmac_sbox[t[1]] ^ rcon[i / 4 - 1];
+                        t[1] = cmac_sbox[t[2]];
+                        t[2] = cmac_sbox[t[3]];
+                        t[3] = cmac_sbox[u];
+                }
+                for (j = 0; j < 4; j++) {
+                        rk[i * 4 + j] = rk[(i - 4) * 4 + j] ^ t[j];
+                }
+        }
+}
+
+/* CBC-MAC step over nblocks full blocks: state = E(state ^ block). */
+static void
+cmac_blocks_ref(const uint8_t key[16], const uint8_t rk[176], uint8_t state[16], const uint8_t *data, size_t nblocks)
+{
+        uint8_t in[16];
+        size_t i;
+
+        (void)rk;
+        while (nblocks--) {
+                for (i = 0; i < 16; i++) {
+                        in[i] = state[i] ^ data[i];
+                }
+                AES128_ECB_encrypt(in, key, state);
+                data += 16;
+        }
+}
+
+#if defined(__aarch64__)
+__attribute__((target("+crypto")))
+static void
+cmac_blocks_armce(const uint8_t key[16], const uint8_t rk[176], uint8_t state[16], const uint8_t *data, size_t nblocks)
+{
+        uint8x16_t k[11];
+        uint8x16_t s;
+        int r;
+
+        (void)key;
+        for (r = 0; r < 11; r++) {
+                k[r] = vld1q_u8(rk + 16 * r);
+        }
+        s = vld1q_u8(state);
+        while (nblocks--) {
+                s = veorq_u8(s, vld1q_u8(data));
+                data += 16;
+                for (r = 0; r < 9; r++) {
+                        s = vaesmcq_u8(vaeseq_u8(s, k[r]));
+                }
+                s = veorq_u8(vaeseq_u8(s, k[9]), k[10]);
+        }
+        vst1q_u8(state, s);
+}
+#elif defined(__x86_64__)
+__attribute__((target("aes,sse2")))
+static void
+cmac_blocks_aesni(const uint8_t key[16], const uint8_t rk[176], uint8_t state[16], const uint8_t *data, size_t nblocks)
+{
+        __m128i k[11];
+        __m128i s;
+        int r;
+
+        (void)key;
+        for (r = 0; r < 11; r++) {
+                k[r] = _mm_loadu_si128((const __m128i *)(rk + 16 * r));
+        }
+        s = _mm_loadu_si128((const __m128i *)state);
+        while (nblocks--) {
+                s = _mm_xor_si128(s, _mm_loadu_si128((const __m128i *)data));
+                data += 16;
+                s = _mm_xor_si128(s, k[0]);
+                for (r = 1; r < 10; r++) {
+                        s = _mm_aesenc_si128(s, k[r]);
+                }
+                s = _mm_aesenclast_si128(s, k[10]);
+        }
+        _mm_storeu_si128((__m128i *)state, s);
+}
+#endif
+
+static cmac_blocks_fn cmac_impl;
+static const char *cmac_impl_name = "reference";
+
+static cmac_blocks_fn
+cmac_select(void)
+{
+        cmac_blocks_fn fn = cmac_impl;
+
+        if (fn != NULL) {
+                return fn;
+        }
+        fn = cmac_blocks_ref;
+#if defined(__aarch64__)
+        if (getauxval(AT_HWCAP) & HWCAP_AES) {
+                fn = cmac_blocks_armce;
+                cmac_impl_name = "ARMv8 Crypto Extensions";
+        }
+#elif defined(__x86_64__)
+        __builtin_cpu_init();
+        if (__builtin_cpu_supports("aes")) {
+                fn = cmac_blocks_aesni;
+                cmac_impl_name = "AES-NI";
+        }
+#endif
+        cmac_impl = fn; /* The same value from any thread. */
+        return fn;
+}
+
+/* Which block cipher SMB 3.x signing uses on this CPU. */
+const char *
+smb3_cmac_implementation(void)
+{
+        cmac_select();
+        return cmac_impl_name;
+}
+
+static void
+cmac_double(uint8_t k[16])
+{
+        int msb = k[0] & 0x80;
+        int i;
+
+        for (i = 0; i < 15; i++) {
+                k[i] = (uint8_t)((k[i] << 1) | (k[i + 1] >> 7));
+        }
+        k[15] = (uint8_t)(k[15] << 1);
+        if (msb) {
+                k[15] ^= 0x87;
+        }
+}
+
+/* RFC 4493 AES-CMAC of the concatenated iovecs. */
+void
+smb3_aes_cmac_128_iov(const uint8_t key[16], const struct smb2_iovec *iov, size_t niov, uint8_t mac[16])
+{
+        cmac_blocks_fn blocks = cmac_select();
+        uint8_t rk[176];
+        uint8_t k1[16] = {0}, k2[16], state[16] = {0}, part[16];
+        size_t total = 0, before_last, done = 0, plen = 0, i, j;
+
+        cmac_expand_key(key, rk);
+        blocks(key, rk, k1, k1, 1); /* L = E(0): state 0 xor block 0. */
+        cmac_double(k1);
+        memcpy(k2, k1, 16);
+        cmac_double(k2);
+        memset(state, 0, 16);
+
+        for (i = 0; i < niov; i++) {
+                total += iov[i].len;
+        }
+        /* Every block but the last goes through the CBC-MAC as it comes; the last is mixed with K1 or K2 first. */
+        before_last = total == 0 ? 0 : (total - 1) / 16;
+        for (i = 0; i < niov; i++) {
+                const uint8_t *p = iov[i].buf;
+                size_t len = iov[i].len;
+
+                while (len > 0) {
+                        size_t take;
+
+                        if (plen == 0 && done < before_last && len >= 16) {
+                                size_t n = len / 16;
+                                if (n > before_last - done) {
+                                        n = before_last - done;
+                                }
+                                blocks(key, rk, state, p, n);
+                                p += 16 * n;
+                                len -= 16 * n;
+                                done += n;
+                                continue;
+                        }
+                        take = 16 - plen < len ? 16 - plen : len;
+                        memcpy(part + plen, p, take);
+                        plen += take;
+                        p += take;
+                        len -= take;
+                        if (plen == 16 && done < before_last) {
+                                blocks(key, rk, state, part, 1);
+                                done++;
+                                plen = 0;
+                        }
+                }
+        }
+        if (total > 0 && plen == 16) {
+                for (j = 0; j < 16; j++) {
+                        part[j] ^= k1[j];
+                }
+        } else {
+                part[plen] = 0x80;
+                memset(part + plen + 1, 0, 15 - plen);
+                for (j = 0; j < 16; j++) {
+                        part[j] ^= k2[j];
+                }
+        }
+        blocks(key, rk, state, part, 1);
+        memcpy(mac, state, 16);
+}
