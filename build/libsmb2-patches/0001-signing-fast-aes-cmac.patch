+/*
+ * AES-CMAC over iovecs, for SMB 3.x signing (frame player patch).
+ *
+ * The reference path above expands the AES key for every 16-byte block and signs a malloc'd copy of the whole PDU, so
+ * checking the signature of a 1 MiB READ response cost about 9 ms of CPU per MiB on x86. Here the key is expanded once
+ * per signature, the iovecs are read in place, and the block cipher uses ARMv8 Crypto Extensions or AES-NI when the CPU
+ * has them (checked once at run time), else AES128_ECB_encrypt().
+ */
+#include <stddef.h>
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#include <sys/auxv.h>
+#ifndef HWCAP_AES
+#define HWCAP_AES (1 << 3)
+#endif
+#elif defined(__x86_64__)
+#include <emmintrin.h>
+#include <wmmintrin.h>
+#endif
+
