#include <winres.h>

1 RT_MANIFEST "pc-windows.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904b0"
    BEGIN
      VALUE "FileDescription", "PC windows in the headset"
      VALUE "FileVersion", "0.1"
      VALUE "InternalName", "pc-windows"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "pc-windows.exe"
      VALUE "ProductName", "FrameCine"
      VALUE "ProductVersion", "0.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x809, 1200
  END
END
